# Copy to .env locally. Never commit the filled file.
# Keys remain empty until configured by the operator. Keys alone do not authorize mail processing.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
# The default data root is the checkout root; keep storage on disk, not tmpfs.
# EMAIL_AGENT_PROJECT_ROOT=/absolute/path/to/postmark
# Existing qwen3.5:4b defaults; measure hardware before changing them.
POSTMARK_LOCAL_CONTEXT=16384
POSTMARK_LOCAL_RAM_MB=3072
