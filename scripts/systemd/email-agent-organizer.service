[Unit]
Description=Postmark bounded read-only mailbox organizer
After=network-online.target email-agent-web.service
Wants=network-online.target email-agent-web.service

[Service]
Type=oneshot
User=postmark
WorkingDirectory=/opt/postmark
Environment=PYTHONPATH=/opt/postmark/src
ExecStart=/opt/postmark/.venv/bin/python -m email_agent.workers.continuous_mail
TimeoutStartSec=7min
NoNewPrivileges=true
UMask=0077
